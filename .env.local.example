# Supabase project settings. The intent API requires the anon key; the contact
# API should use the service-role key. Keep every value server-side.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Protects GET /api/intent, GET /api/contact, PATCH /api/contact, and
# the /intelligence dashboard. Generate a long random value, for example:
# openssl rand -hex 32
INTELLIGENCE_SECRET=replace_with_a_long_random_value

# Optional: move Next.js output outside a OneDrive-synced workspace on Windows.
# NEXT_DIST_DIR=C:/Dev/wwwine-build
